# Copy to .env and adjust; docker compose reads .env from this directory.
# The settings are described in ../README.md#configuration. None is required:
# each may stay as it is, and an empty value means the default named in its
# comment. Do set system_ip in UNIFI_PROPERTIES.

# The (non-root) UID/GID the application runs as and owns its data volume
# with (empty: 1000). Any IDs work; your own (id -u / id -g) let you read the
# volume's files without root.
PUID=1000
PGID=1000

# The application image: the published one, or for one built on this host
# with ../app/build.sh --latest, localhost/unifi-network-application:latest.
# Any tag works, e.g. :10.6.109 to pin a version (empty: the published :latest).
UNIFI_IMAGE=ghcr.io/peku33/unifi-network-application:latest

# Device inform and UI ports: published under the same numbers on the host,
# and passed to the application (unifi.http.port / unifi.https.port)
# (empty: 8080 / 8443).
UNIFI_HTTP_PORT=8080
UNIFI_HTTPS_PORT=8443

# system.properties settings; several are separated by \n inside the quotes.
# Set system_ip to the host's LAN IP: the address devices are told to inform to.
UNIFI_PROPERTIES="system_ip=192.168.1.10"
# UNIFI_PROPERTIES="system_ip=192.168.1.10\nunifi.https.hsts=false"

# Time zone, e.g. Europe/Berlin (empty: UTC).
TZ=UTC
# JVM heap: -Xmx (empty: 1024M) and -Xms (empty: unset), e.g. 512M or 2G.
JVM_MAX_HEAP=
JVM_INIT_HEAP=
# Extra JVM options (empty: none).
JVM_EXTRA_OPTS=
# MongoDB's host:port (empty: 127.0.0.1:27017, the MongoDB in this stack).
MONGO_ADDRESS=
# How long to wait for MongoDB at startup, in seconds (empty: 120).
MONGO_WAIT_SECONDS=

# MongoDB's image tag (empty: 8, the newest 8.x release). 4.4.18 for CPUs
# without AVX (amd64) or older than ARMv8.2-A (arm64), see
# ../README.md#cpu-support.
MONGO_VERSION=8
# MongoDB's cache, in GB (empty: 0.25, the smallest it accepts).
MONGO_CACHE_SIZE_GB=0.25
