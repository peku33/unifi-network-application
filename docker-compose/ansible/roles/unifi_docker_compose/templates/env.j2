{#- Derived from docker-compose/.env.example: its values are the defaults, overridden by
    the images, unifi_env and the system.properties settings. -#}
{#- YAML booleans are written as true / false, not Python's True / False. -#}
{%- macro text(value) -%}{{ (value | string | lower) if value is boolean else value }}{%- endmacro -%}
{%- set defaults = {} -%}
{%- for line in lookup('ansible.builtin.file', unifi_setup_dir ~ '/.env.example').splitlines() -%}
{%-   if line is match('^[A-Za-z_][A-Za-z0-9_]*=') -%}
{%-     set _ = defaults.update({line.split('=', 1)[0]: line.split('=', 1)[1]}) -%}
{%-   endif -%}
{%- endfor -%}
{%- set env = defaults | combine({
      'UNIFI_IMAGE': unifi_image ~ ':' ~ unifi_image_tag,
      'MONGO_VERSION': unifi_mongo_version,
    }) | combine(unifi_env) -%}
{#- UNIFI_PROPERTIES always comes from unifi_effective_properties (see
    vars/main.yml), never from the example value in .env.example. -#}
{%- set lines = [] -%}
{%- for key, value in unifi_effective_properties | dictsort -%}
{%-   set _ = lines.append(key ~ '=' ~ text(value)) -%}
{%- endfor -%}
{%- set env = env | combine({'UNIFI_PROPERTIES': '"' ~ (lines | join('\\n')) ~ '"'}) -%}
# {{ ansible_managed }}
# Generated from docker-compose/.env.example with this host's settings.
{% for key, value in env.items() %}
{{ key }}={{ text(value) }}
{% endfor %}
