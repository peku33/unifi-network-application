# Quadlet unit: install together with unifi-network-application.yaml and
# unifi-network-application-config.yaml into ~/.config/containers/systemd/ and
# systemd generates unifi-network-application.service from it (see README.md).
[Unit]
Description=UniFi Network Application
Wants=network-online.target
After=network-online.target

[Kube]
# Both relative to this file.
Yaml=unifi-network-application.yaml
ConfigMap=unifi-network-application-config.yaml
# Run the containers as your own UID/GID, so the volumes stay owned by you.
UserNS=keep-id
# Automatic updates, off by default: uncomment, and see README.md#automatic-updates.
#AutoUpdate=registry

[Service]
# Quadlet only adds "ExecStopPost=podman kube down", which removes the pod
# almost immediately and leaves MongoDB uncleanly shut down. Stop gracefully
# first (systemd runs ExecStop lines in order, before ExecStopPost): the
# application before MongoDB, because it stalls on shutdown if MongoDB goes first.
ExecStop=/usr/bin/podman stop --ignore --time 90 unifi-network-application-app
ExecStop=/usr/bin/podman pod stop --ignore --time 90 unifi-network-application
Restart=always
# The first start pulls the images. A stop waits up to 90 s for each of the two
# ExecStop lines.
TimeoutStartSec=600
TimeoutStopSec=200

[Install]
WantedBy=default.target
